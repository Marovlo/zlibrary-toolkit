# zlib 私人 web 面板 systemd 服务单元
#
# 用法见 webapp/README.md「域名访问（HTTPS）」一节。
# 安装：
#   sudo cp webapp/zlib-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now zlib-web
#
# 注意：WorkingDirectory / ExecStart 路径写死为 /root/zlibrary，User=root。
# 如果你的仓库不在 /root/zlibrary 或不以 root 运行，请相应修改下方三处。
[Unit]
Description=zlib 私人 web 面板 (FastAPI + uvicorn)
After=network-online.target caddy.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/zlibrary
ExecStart=/root/zlibrary/.venv/bin/python -m uvicorn app.main:app \
    --app-dir /root/zlibrary/webapp/backend \
    --host 127.0.0.1 --port 8765 \
    --log-config /root/zlibrary/webapp/backend/logging_config.yaml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
